SITE_PASSWORD=changeme
GATE_SECRET=change-this-to-a-random-secret

# Where the site's video files are served from.
#
# The ten videos are ~282MB re-encoded and are NOT in the repository
# (/public/videos is gitignored), so a deploy built from git has no video in
# it. Upload the files to a host — a Vercel Blob store, an S3/R2 bucket, any
# https origin — and point this at the folder that contains them.
#
#   NEXT_PUBLIC_VIDEO_BASE_URL=https://xxxx.public.blob.vercel-storage.com/videos
#
# Leave it unset for local development: paths stay as /videos/... and are
# served straight out of public/, which is where the files already are.
# See src/lib/videoSrc.ts.
NEXT_PUBLIC_VIDEO_BASE_URL=
